# ---------------------------------------------------------------------------
# My Home – Umgebungsvariablen
# Lokal in .env.local kopieren, auf Vercel unter Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Datenbank (Pflicht). Neon/Vercel-Postgres-URLs werden automatisch erkannt
# (HTTP-Treiber), jede andere Postgres-URL nutzt einen normalen pg-Pool.
DATABASE_URL=postgres://user:password@localhost:5432/myhome
# Optional für Migrationen: direkte (nicht gepoolte) Verbindung
# DATABASE_URL_UNPOOLED=
# Bestehende Vercel-Projekte haben evtl. noch POSTGRES_URL – wird ebenfalls gelesen.

# Session-Signatur (Pflicht in Produktion, mind. 32 Zeichen):
#   openssl rand -base64 48
AUTH_SECRET=

# Öffentliche Adresse für Links in E-Mails (Einladung, Passwort vergessen).
# Auf Vercel optional – sonst wird die Produktions-Domain verwendet.
APP_URL=https://home.moritz-wecht.de

# E-Mail-Versand über Resend (für Einladungen & Passwort vergessen)
RESEND_API_KEY=
EMAIL_FROM="My Home <login@home.moritz-wecht.de>"

# Push-Benachrichtigungen (Ablese-Erinnerung), optional:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Absicherung des täglichen Jobs /api/cron/daily (Vercel Cron sendet ihn automatisch mit)
CRON_SECRET=

# Nur für `npm run test:browser`: eigene, leere Test-Datenbank (wird geleert!)
# E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/myhome_e2e
